# FunInferAgent configuration template — copy and adjust, then `source` it
# (or export the variables) before running the pipeline.
# NO credentials are required for local servers (Ollama / vLLM); for hosted
# APIs set FUNINFER_LLM_API_KEY in your environment, never in the repo.

# --- LLM endpoint (OpenAI-compatible) ---
# Ollama default:   
# vLLM default:     
export FUNINFER_LLM_BASE_URL=""
export FUNINFER_LLM_API_KEY="ollama"        # placeholder; real key if hosted

# --- Models ---
export FUNINFER_MODEL="qwen2.5-coder:32b"   # inference (naming/summary)
export FUNINFER_EVAL_MODEL="qwen2.5-coder:32b"  # LLM judge for evaluation
export FUNINFER_EVAL_THRESHOLD="80"         # eval_semantic.py judge mode:
                                            #   THRESHOLD=0 token-based (default)
                                            #   THRESHOLD=80 score-based judge
# export EVAL_JOBS=8                        # parallel judge requests

# --- IDA ---
export IDAT64="idat64"                      # or /opt/idapro-9.0/idat64
# Headless IDA needs an accepted EULA; point IDAUSR at a user dir where you
# have accepted it once in the GUI. For parallel runs, set a PREFIX instead
# and the driver appends _<binary> per job.
# export IDAUSR="$HOME/.idapro"
# export IDAUSR_PREFIX="$HOME/.idapro_funinfer"

# --- Dataset ---
export FUNINFER_DATASET="/path/to/FunInferAgent/dataset"

# --- Ablation (main paper: RQ3) ---
# export FUNINFER_ABLATION="wo_s1"   # remove callee summaries
# export FUNINFER_ABLATION="wo_s2"   # remove local decompiled code
# export FUNINFER_ABLATION="wo_s3"   # remove parent call contexts

# --- Parameter sensitivity (paper §4.4.2) ---
# export LPARENT=5      # max parent contexts per function   (axis: 0,1,2,3,5,8,10)
# export LSUMMARY=100   # max words per callee summary       (axis: 10,25,50,100,200)
